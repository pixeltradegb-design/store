---
import products from '../data/products.json';

const storeName = "SOLE ARCHIVE GB";
const storeTagline = "Curated Footwear, Deadstock & Vintage Streetwear";
---

<!DOCTYPE html>
<html lang="en" class="bg-neutral-950 text-neutral-100">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{storeName} | {storeTagline}</title>
  </head>
  <body class="min-h-screen selection:bg-white selection:text-black">
    
    <!-- Top Banner -->
    <div class="bg-neutral-900 border-b border-neutral-800 text-center py-2 px-4 text-xs font-mono uppercase tracking-widest text-neutral-300">
      📦 100% Authentic • UK Next Day Dispatch • Use code <span class="text-white font-bold underline">WELCOME10</span>
    </div>

    <!-- Header -->
    <header class="max-w-7xl mx-auto px-6 py-8 flex flex-col sm:flex-row items-center justify-between gap-4 border-b border-neutral-800/80">
      <div>
        <a href="/" class="text-2xl sm:text-3xl font-black tracking-tighter uppercase text-white hover:opacity-90 transition">
          {storeName}<span class="text-rose-500">.</span>
        </a>
        <p class="text-xs font-mono text-neutral-400 mt-1 uppercase tracking-wider">{storeTagline}</p>
      </div>

      <div class="flex items-center gap-3 text-xs font-mono">
        <span class="px-3 py-1 rounded-full bg-neutral-900 border border-neutral-800 text-neutral-300">
          📍 UK Stock
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-neutral-900 border border-neutral-800 text-emerald-400">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          New Drop Live
        </span>
      </div>
    </header>

    <!-- Product Grid -->
    <main class="max-w-7xl mx-auto px-6 py-12">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {products.map((item) => (
          <div class="product-card group bg-neutral-900/50 border border-neutral-800 hover:border-neutral-700 rounded-2xl overflow-hidden flex flex-col justify-between transition-all duration-300 hover:shadow-xl hover:shadow-black/50">
            <div>
              <!-- Media Container -->
              <div class="relative w-full aspect-square bg-neutral-950 overflow-hidden">
                {item.badge && (
                  <span class="absolute top-3 left-3 z-20 px-2.5 py-1 bg-black/80 backdrop-blur-md border border-neutral-700 text-[10px] font-mono font-bold uppercase tracking-widest text-rose-400 rounded-md">
                    {item.badge}
                  </span>
                )}

                <span class="absolute top-3 right-3 z-20 px-2.5 py-1 bg-neutral-900/90 backdrop-blur-md border border-neutral-700 text-[11px] font-mono font-bold uppercase text-white rounded-md">
                  {item.size}
                </span>

                <!-- Default Image -->
                <img 
                  src={item.image} 
                  alt={item.name}
                  class="product-img absolute inset-0 w-full h-full object-cover transition-opacity duration-300 z-10 group-hover:opacity-0"
                />

                <!-- Dynamic Video Spin / On-Foot Clip -->
                {item.video && (
                  <video
                    src={item.video}
                    poster={item.image}
                    muted
                    loop
                    playsinline
                    preload="metadata"
                    class="product-video absolute inset-0 w-full h-full object-cover z-0"
                  />
                )}
              </div>

              <!-- Product Details -->
              <div class="p-5">
                <div class="flex items-center justify-between gap-2 text-xs font-mono text-neutral-400 mb-1">
                  <span>{item.category}</span>
                  <span class="text-neutral-500">•</span>
                  <span class="text-emerald-400">{item.condition}</span>
                </div>

                <div class="flex items-baseline justify-between gap-2 mt-1">
                  <h3 class="font-bold text-base text-white tracking-tight group-hover:text-rose-400 transition">
                    {item.name}
                  </h3>
                  <span class="font-mono text-sm font-semibold text-neutral-100 shrink-0">
                    £{(item.price / 100).toFixed(2)}
                  </span>
                </div>

                <p class="text-xs text-neutral-400 mt-2 leading-relaxed line-clamp-2">
                  {item.description}
                </p>
              </div>
            </div>

            <!-- Instant Checkout Form -->
            <div class="p-5 pt-0">
              <form action="/api/checkout" method="POST">
                <input type="hidden" name="productId" value={item.id} />
                <button 
                  type="submit" 
                  class="w-full bg-white hover:bg-neutral-200 active:scale-[0.99] text-black font-bold text-xs uppercase tracking-wider py-3.5 rounded-xl transition duration-200 flex items-center justify-center gap-2 cursor-pointer"
                >
                  <span>Buy Now • £{(item.price / 100).toFixed(2)}</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </button>
              </form>
            </div>
          </div>
        ))}
      </div>
    </main>

    <!-- Hover Video Playback Script -->
    <script>
      document.querySelectorAll('.product-card').forEach((card) => {
        const video = card.querySelector<HTMLVideoElement>('.product-video');
        if (video) {
          card.addEventListener('mouseenter', () => {
            video.play().catch(() => {});
          });
          card.addEventListener('mouseleave', () => {
            video.pause();
            video.currentTime = 0;
          });
        }
      });
    </script>
  </body>
</html>