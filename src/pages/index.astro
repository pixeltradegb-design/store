---
import products from '../data/products.json';
import '../styles/global.css';

const storeName = "SOLE ARCHIVE GB";
const storeTagline = "Curated Footwear, Deadstock & Vintage Streetwear";
---

<!DOCTYPE html>
<html lang="en" class="bg-neutral-950 text-neutral-100">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{storeName} | {storeTagline}</title>
  </head>
  <body class="min-h-screen selection:bg-white selection:text-black">
    
    <!-- Top Announcement Bar -->
    <div class="bg-neutral-900 border-b border-neutral-800 text-center py-2 px-4 text-xs font-mono uppercase tracking-widest text-neutral-300">
      📦 100% Authentic • UK Next Day Dispatch • Use code <span class="text-white font-bold underline">WELCOME10</span>
    </div>

    <!-- Header -->
    <header class="max-w-7xl mx-auto px-6 py-8 flex flex-col sm:flex-row items-center justify-between gap-4 border-b border-neutral-800/80">
      <div>
        <a href="/" class="text-2xl sm:text-3xl font-black tracking-tighter uppercase text-white hover:opacity-90 transition">
          {storeName}<span class="text-rose-500">.</span>
        </a>
        <p class="text-xs font-mono text-neutral-400 mt-1 uppercase tracking-wider">{storeTagline}</p>
      </div>

      <div class="flex items-center gap-3 text-xs font-mono">
        <span class="px-3 py-1 rounded-full bg-neutral-900 border border-neutral-800 text-neutral-300">
          📍 UK Stock
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-neutral-900 border border-neutral-800 text-emerald-400">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          New Drop Live
        </span>
      </div>
    </header>

    <!-- Product Grid -->
    <main class="max-w-7xl mx-auto px-6 py-12">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {products.map((item) => (
          <div class="product-card group bg-neutral-900/50 border border-neutral-800 hover:border-neutral-700 rounded-2xl overflow-hidden flex flex-col justify-between transition-all duration-300 hover:shadow-xl hover:shadow-black/50">
            <div>
              <!-- Media Container -->
              <div class="relative w-full aspect-square bg-neutral-950 overflow-hidden">
                {item.badge && (
                  <span class="absolute top-3 left-3 z-20 px-2.5 py-1 bg-black/80 backdrop-blur-md border border-neutral-700 text-[10px] font-mono font-bold uppercase tracking-widest text-rose-400 rounded-md">
                    {item.badge}
                  </span>
                )}

                <span class="absolute top-3 right-3 z-20 px-2.5 py-1 bg-neutral-900/90 backdrop-blur-md border border-neutral-700 text-[11px] font-mono font-bold uppercase text-white rounded-md">
                  {item.size}
                </span>

                <!-- Static Flat-lay Image -->
                <img 
                  src={item.image} 
                  alt={item.name}
                  class="product-img absolute inset-0 w-full h-full object-cover transition-opacity duration-300 z-10 group-hover:opacity-0"
                />

                <!-- Dynamic Video Spin / On-Foot Clip -->
                {item.video && (
                  <video
                    src={item.video}
                    poster={item.image}
                    muted
                    loop
                    playsinline
                    preload="metadata"
                    class="product-video absolute inset-0 w-full h-full object-cover z-0"
                  />
                )}
              </div>

              <!-- Product Details -->
              <div class="p-5">
                <div class="flex items-center justify-between gap-2 text-xs font-mono text-neutral-400 mb-1">
                  <span>{item.category}</span>
                  <span class="text-neutral-500">•</span>
                  <span class="text-emerald-400">{item.condition}</span>
                </div>

                <div class="flex items-baseline justify-between gap-2 mt-1">
                  <h3 class="font-bold text-base text-white tracking-tight group-hover:text-rose-400 transition">
                    {item.name}
                  </h3>
                  <span class="font-mono text-sm font-semibold text-neutral-100 shrink-0">
                    £{(item.price / 100).toFixed(2)}
                  </span>
                </div>

                <p class="text-xs text-neutral-400 mt-2 leading-relaxed line-clamp-2">
                  {item.description}
                </p>
              </div>
            </div>

            <!-- Instant Checkout Trigger -->
            <div class="p-5 pt-0">
              <button 
                type="button" 
                data-product-id={item.id}
                class="checkout-btn w-full bg-white hover:bg-neutral-200 active:scale-[0.99] text-black font-bold text-xs uppercase tracking-wider py-3.5 rounded-xl transition duration-200 flex items-center justify-center gap-2 cursor-pointer"
              >
                <span>Buy Now • £{(item.price / 100).toFixed(2)}</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </button>
            </div>
          </div>
        ))}
      </div>

      <!-- Drop Notification / Newsletter -->
      <section class="mt-20 max-w-2xl mx-auto border border-neutral-800 bg-neutral-900/60 backdrop-blur-md rounded-3xl p-8 sm:p-10 text-center relative overflow-hidden">
        <div class="relative z-10">
          <span class="px-3 py-1 rounded-full bg-rose-500/10 border border-rose-500/20 text-rose-400 text-[11px] font-mono font-bold uppercase tracking-widest">
            Early Access & Restocks
          </span>
          <h2 class="text-2xl sm:text-3xl font-black uppercase tracking-tight text-white mt-4">
            Never Miss A Drop
          </h2>
          <p class="text-neutral-400 text-xs sm:text-sm mt-2 max-w-md mx-auto leading-relaxed">
            Join the archive priority list for direct notification on 1-of-1 pieces, deadstock sneaker pairs, and an instant 10% discount code.
          </p>

          <form id="newsletter-form" class="mt-6 flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
            <input 
              type="email" 
              name="email"
              required
              placeholder="Enter your email" 
              class="w-full px-4 py-3 bg-neutral-950 border border-neutral-800 rounded-xl text-white text-xs font-mono placeholder:text-neutral-600 focus:outline-none focus:border-rose-500 transition"
            />
            <button 
              type="submit" 
              id="newsletter-submit"
              class="bg-rose-500 hover:bg-rose-600 active:scale-95 text-white font-bold text-xs uppercase tracking-wider px-6 py-3 rounded-xl transition shrink-0 cursor-pointer"
            >
              Get Code
            </button>
          </form>

          <div id="newsletter-msg" class="hidden text-xs font-mono mt-4"></div>
        </div>
      </section>
    </main>

    <footer class="border-t border-neutral-800/80 py-8 text-center text-neutral-500 text-xs font-mono">
      © 2026 {storeName}. All rights reserved.
    </footer>

    <!-- Interactive Scripts -->
    <script>
      // Video hover control
      document.querySelectorAll('.product-card').forEach((card) => {
        const video = card.querySelector<HTMLVideoElement>('.product-video');
        if (video) {
          card.addEventListener('mouseenter', () => {
            video.play().catch(() => {});
          });
          card.addEventListener('mouseleave', () => {
            video.pause();
            video.currentTime = 0;
          });
        }
      });

      // Checkout handler
      document.querySelectorAll('.checkout-btn').forEach((button) => {
        button.addEventListener('click', async (e) => {
          const btn = e.currentTarget as HTMLButtonElement;
          const productId = btn.getAttribute('data-product-id');
          const originalText = btn.innerHTML;

          btn.disabled = true;
          btn.innerHTML = `<span>Loading Checkout...</span>`;

          try {
            const response = await fetch('/api/checkout', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ productId }),
            });

            const data = await response.json();

            if (data.url) {
              window.location.href = data.url;
            } else {
              alert(data.error || 'Failed to initialize checkout');
              btn.disabled = false;
              btn.innerHTML = originalText;
            }
          } catch (err) {
            console.error('Checkout error:', err);
            alert('Something went wrong. Please try again.');
            btn.disabled = false;
            btn.innerHTML = originalText;
          }
        });
      });

      // Newsletter handler
      const nlForm = document.getElementById('newsletter-form') as HTMLFormElement;
      const nlMsg = document.getElementById('newsletter-msg') as HTMLDivElement;
      const nlBtn = document.getElementById('newsletter-submit') as HTMLButtonElement;

      if (nlForm) {
        nlForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          const emailInput = nlForm.querySelector<HTMLInputElement>('input[name="email"]');
          if (!emailInput) return;

          nlBtn.disabled = true;
          nlBtn.textContent = '...';

          try {
            const res = await fetch('/api/newsletter', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ email: emailInput.value }),
            });

            const result = await res.json();
            nlMsg.classList.remove('hidden');

            if (res.ok) {
              nlMsg.className = 'text-xs font-mono mt-4 text-emerald-400';
              nlMsg.innerHTML = `${result.message} <span class="underline font-bold">${result.code}</span>`;
              nlForm.reset();
            } else {
              nlMsg.className = 'text-xs font-mono mt-4 text-rose-400';
              nlMsg.textContent = result.error || 'Subscription failed.';
            }
          } catch {
            nlMsg.classList.remove('hidden');
            nlMsg.className = 'text-xs font-mono mt-4 text-rose-400';
            nlMsg.textContent = 'Network error. Please try again.';
          } finally {
            nlBtn.disabled = false;
            nlBtn.textContent = 'Get Code';
          }
        });
      }
    </script>
  </body>
</html>