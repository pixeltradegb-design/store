---
import Stripe from 'stripe';

const sessionId = Astro.url.searchParams.get('session_id');

let session: Stripe.Checkout.Session | null = null;
let lineItems: Stripe.LineItem[] = [];

if (sessionId) {
  try {
    const stripe = new Stripe(process.env.STRIPE_SECRET_KEY as string);
    session = await stripe.checkout.sessions.retrieve(sessionId, {
      expand: ['line_items', 'customer_details', 'shipping_details'],
    });

    if (session.line_items) {
      lineItems = session.line_items.data;
    }
  } catch (err) {
    console.error('Error retrieving session:', err);
  }
}
---

<!DOCTYPE html>
<html lang="en" class="bg-neutral-950 text-neutral-100">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Order Confirmed | Sole Archive GB</title>
  </head>
  <body class="min-h-screen flex flex-col items-center justify-center p-4">
    <div class="max-w-2xl w-full bg-neutral-900 border border-neutral-800 rounded-2xl p-8 sm:p-10 my-8 shadow-2xl">
      
      {session ? (
        <div>
          <!-- Header -->
          <div class="text-center">
            <div class="w-14 h-14 bg-rose-500/10 border border-rose-500/20 text-rose-400 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <h1 class="text-2xl sm:text-3xl font-black uppercase tracking-tight text-white">Order Confirmed</h1>
            <p class="text-neutral-400 text-sm mt-2">
              Confirmation receipt sent to <span class="text-white font-medium">{session.customer_details?.email}</span>
            </p>
          </div>

          <!-- Metadata Grid -->
          <div class="mt-8 border-t border-b border-neutral-800 py-4 grid grid-cols-2 gap-4 text-xs font-mono">
            <div>
              <p class="text-neutral-500 uppercase">Order ID</p>
              <p class="text-neutral-300 truncate mt-0.5">{session.id}</p>
            </div>
            <div class="text-right">
              <p class="text-neutral-500 uppercase">Payment Status</p>
              <span class="inline-flex items-center px-2 py-0.5 rounded bg-emerald-950 text-emerald-400 uppercase font-bold mt-0.5 border border-emerald-800/50">
                {session.payment_status}
              </span>
            </div>
          </div>

          <!-- Purchased Items -->
          <div class="mt-6">
            <h2 class="text-xs font-mono uppercase tracking-widest text-neutral-400 mb-3">Items Purchased</h2>
            <ul class="divide-y divide-neutral-800">
              {lineItems.map((item) => (
                <li class="py-3 flex justify-between items-center text-sm">
                  <div>
                    <p class="font-bold text-white">{item.description}</p>
                    <p class="text-neutral-500 text-xs font-mono">Qty: {item.quantity}</p>
                  </div>
                  <p class="font-mono font-semibold text-neutral-200">
                    £{((item.amount_total || 0) / 100).toFixed(2)}
                  </p>
                </li>
              ))}
            </ul>
          </div>

          <!-- Shipping Destination -->
          {session.shipping_details?.address && (
            <div class="mt-6 bg-neutral-950/70 border border-neutral-800 rounded-xl p-4 text-xs">
              <h3 class="font-mono uppercase tracking-wider text-neutral-400 mb-2">Delivery Address</h3>
              <p class="text-white font-medium">{session.shipping_details.name}</p>
              <p class="text-neutral-400 mt-0.5">{session.shipping_details.address.line1}</p>
              {session.shipping_details.address.line2 && (
                <p class="text-neutral-400">{session.shipping_details.address.line2}</p>
              )}
              <p class="text-neutral-400">
                {session.shipping_details.address.city}, {session.shipping_details.address.postal_code}
              </p>
            </div>
          )}

          <!-- Total Paid -->
          <div class="mt-6 flex justify-between items-center font-bold text-base border-t border-neutral-800 pt-4">
            <span class="uppercase tracking-wider text-neutral-300">Total Paid</span>
            <span class="font-mono text-lg text-white">£{((session.amount_total || 0) / 100).toFixed(2)}</span>
          </div>

          <!-- Next Drop Discount Perk -->
          <div class="mt-8 bg-gradient-to-br from-neutral-950 to-neutral-900 border border-neutral-800 p-5 rounded-xl text-center">
            <p class="text-[10px] font-mono uppercase tracking-widest text-rose-400 font-bold">Exclusive Collector Code</p>
            <p class="text-sm font-bold text-white mt-1">Get 10% off your next cop</p>
            <p class="text-xs text-neutral-400 mt-1">Apply this code at checkout on your next order:</p>
            <div class="mt-3 inline-block bg-neutral-900 border border-neutral-700 px-4 py-1.5 rounded-lg font-mono text-xs tracking-widest font-bold text-white">
              ARCHIVE10
            </div>
          </div>

          <!-- Back Button -->
          <div class="mt-8 text-center">
            <a
              href="/"
              class="inline-block bg-neutral-800 hover:bg-neutral-700 text-white text-xs font-mono uppercase tracking-wider px-6 py-3 rounded-xl transition"
            >
              Back to Storefront
            </a>
          </div>
        </div>
      ) : (
        <div class="text-center py-10">
          <h1 class="text-xl font-bold uppercase text-white">No active session found</h1>
          <p class="text-neutral-400 text-xs mt-2">Could not locate an active Stripe checkout reference.</p>
          <a
            href="/"
            class="mt-6 inline-block bg-white text-black text-xs font-bold uppercase tracking-wider px-6 py-2.5 rounded-xl hover:bg-neutral-200 transition"
          >
            Return to Store
          </a>
        </div>
      )}

    </div>
  </body>
</html>