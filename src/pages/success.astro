---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en" class="bg-neutral-950 text-neutral-100">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Order Confirmed</title>
</head>
<body class="min-h-screen flex flex-col items-center justify-center p-6 text-center">
  <div class="max-w-md w-full border border-neutral-800 bg-neutral-900/60 p-8 rounded-2xl">
    <div class="w-12 h-12 bg-white text-black rounded-full flex items-center justify-center mx-auto mb-4 font-bold text-xl">✓</div>
    <h1 class="text-2xl font-bold mb-2">Order Confirmed</h1>
    <p class="text-neutral-400 text-sm mb-6">Payment received. A receipt and shipping tracking details will be sent to your email.</p>
    <a href="/" class="inline-block w-full bg-white text-black hover:bg-neutral-200 py-2.5 rounded-lg text-sm font-semibold transition">
      Back to Store
    </a>
  </div>
</body>
</html>